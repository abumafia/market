# MongoDB ulanishi (Atlas yoki localdan oling)
MONGO_URI=mongodb+srv://refbot:refbot00@gamepaymentbot.ffcsj5v.mongodb.net/market62?retryWrites=true&w=majority

# JWT token uchun secret kalit (kamida 32 ta belgi, random yarating: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here_change_immediately_and_make_strong

# Encryption kaliti delivery uchun (AES-256: openssl rand -hex 32)
ENCRYPTION_KEY=your_32_byte_hex_key_here_like_1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p

# Cloudinary (account yarating: cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin akkaunti (o'zgartiring!)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=strong_password_change_after_first_login

# Konfiguratsiyalar (default qiymatlar kodda bor, lekin o'zgartirsa bo'ladi)
AUTO_RELEASE_HOURS=48  # Auto-release vaqti soatda (24-72)
MIN_PAYOUT=100  # Minimal payout summasi (valyutangizda)
COMMISSION_RATE=5  # Komissiya foizi

# CORS (frontend URL'laringizni vergul bilan ajrating, * - hammasiga)
CORS_ORIGINS=http://localhost:3000,https://yourfrontend.com

# To'lov kartalari admin raqamlari (maskalangan, xavfsiz saqlang)
UZCARD_ADMIN=5614 6887 0520 2686
